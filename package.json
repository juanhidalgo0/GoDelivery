{
  "name": "godelivery",
  "version": "1.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:testing": "vite --mode testing",
    "build": "node ./node_modules/vite/bin/vite.js build && node post-build.js",
    "build:testing": "node ./node_modules/vite/bin/vite.js build --mode testing && node post-build.js",
    "deploy": "npm run build && firebase deploy --only hosting:app",
    "deploy:all": "npm run build && firebase deploy --only hosting,firestore,storage,functions:default",
    "deploy:functions": "firebase deploy --only functions:default",
    "deploy:mango-functions": "firebase deploy --only functions:mango",
    "deploy:testing": "npm run build:testing && firebase deploy --only hosting,firestore,storage,functions:default --project testing"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@capawesome/capacitor-apple-sign-in": "^0.1.2",
    "@capawesome/capacitor-google-sign-in": "^0.1.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "firebase": "^12.12.1",
    "jimp": "^1.6.1",
    "maplibre-gl": "^6.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
