rules_version = '2';

// ============================================================================
// GoDelivery Magdalena — Reglas de seguridad de Firestore
//
// Principio: nada es público salvo el catálogo (comercios, productos, ofertas,
// categorías y configuración de la app). Todo lo demás exige sesión iniciada y,
// donde corresponde, ser el dueño del dato, el comercio dueño del pedido,
// un cadete aprobado o un administrador.
//
// El backend (Cloud Functions con Admin SDK) NO pasa por estas reglas.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Datos del usuario que hace el pedido. Devuelve {} si todavía no tiene doc.
    function ud() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data
        : {};
    }

    function roleOf() {
      return ud().get('role', 'user');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kioscopaulos7@gmail.com' ||
        roleOf() in ['admin', 'superadmin'] ||
        ud().get('isAdmin', false) == true
      );
    }

    function isDriver() {
      return isSignedIn() && (
        roleOf() in ['delivery', 'chofer', 'driver', 'repartidor'] ||
        ud().get('isDelivery', false) == true ||
        ud().get('deliveryStatus', '') == 'approved'
      );
    }

    function isComercioUser() {
      return isSignedIn() && (
        roleOf() == 'comercio' ||
        ud().get('isComercio', false) == true
      );
    }

    // Personal de la plataforma: admin, cadete aprobado o comercio.
    function isStaff() {
      return isAdmin() || isDriver() || isComercioUser();
    }

    // ¿El usuario es dueño de este comercio, o un correo con acceso de dueño (managerIds, que
    // solo escribe functions/commerce-access.js)? Cacheado por Firestore dentro de la misma
    // consulta, así que una query de pedidos cuesta 1 lectura.
    function ownsComercio(cid) {
      return isSignedIn() && cid is string && cid != '' &&
        exists(/databases/$(database)/documents/comercios/$(cid)) &&
        (get(/databases/$(database)/documents/comercios/$(cid)).data.get('ownerId', '') == uid() ||
         uid() in get(/databases/$(database)/documents/comercios/$(cid)).data.get('managerIds', []));
    }

    // Campos que modifica esta escritura.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyFields(allowed) {
      return changed().hasOnly(allowed);
    }

    function isOwnerField(field) {
      return isSignedIn() && resource.data.get(field, '') == uid();
    }

    // ------------------------------------------------------------------ users
    // Lo más sensible de la app: teléfonos, direcciones y roles de todo el pueblo.

    match /users/{userId} {
      function isSelf() {
        return isSignedIn() && userId == uid();
      }

      // Privilegios y plata: jamás editables por el propio usuario.
      function protectedKeys() {
        return [
          'role', 'isAdmin', 'isComercio', 'isDelivery', 'isCanonExempt',
          'commissionRate', 'saldo', 'balance', 'settled',
          'blocked', 'isBlocked', 'suspended', 'ratings',
          // Cuenta corriente y cuota diaria: las maneja el servidor y el admin.
          'deliveryDebt', 'lastCanonChargeDate', 'lastCanonDate', 'lastLiquidationAt',
          'ledgerLastEntryId', 'ledgerOpened', 'ledgerUpdatedAt', 'ledgerSeq'
        ];
      }

      // El saldo del cadete (deliveryDebt) sólo cambia junto con el renglón de la cuenta
      // corriente que lo explica, escrito en la misma operación: ledgerLastEntryId apunta a un
      // renglón nuevo de este cadete cuyo balanceAfter es exactamente el saldo nuevo.
      // Así ningún botón puede poner deudas en $0 (o en cualquier número) sin dejar rastro.
      function ledgerFieldsUntouched() {
        return !changed().hasAny(['deliveryDebt', 'ledgerLastEntryId', 'ledgerOpened', 'ledgerSeq']);
      }
      function ledgerMoveIsValid() {
        let newId = request.resource.data.get('ledgerLastEntryId', '');
        let entryPath = /databases/$(database)/documents/driver_ledger/$(newId);
        return newId is string && newId != '' &&
          newId != resource.data.get('ledgerLastEntryId', '') &&
          request.resource.data.get('ledgerOpened', false) == true &&
          !exists(entryPath) && existsAfter(entryPath) &&
          getAfter(entryPath).data.driverId == userId &&
          getAfter(entryPath).data.balanceAfter == request.resource.data.get('deliveryDebt', 0);
      }

      // Identificadores que la app completa al iniciar sesión en cuentas viejas
      // (clientId, código de referido, ID de cadete). Se pueden escribir una
      // sola vez: si ya existen, no se tocan. Sin esto se rompe el login.
      // Vacío o null cuenta como que no existe: había cuentas con goId '' que nunca podían
      // completarlo (Admin → Errores, "Error assigning goId inside profile", 16-10-2026).
      function backfillOnly(key) {
        return !changed().hasAny([key]) || resource.data.get(key, null) in [null, ''];
      }

      function backfillIsValid() {
        return backfillOnly('clientId') && backfillOnly('referralCode') && backfillOnly('deliveryId') && backfillOnly('goId');
      }

      // Cuenta de revisión de App Store / Google Play: se auto-habilita como
      // cadete de prueba. Es una casilla que controlamos nosotros.
      function isReviewTestAccount() {
        return isSignedIn() && request.auth.token.email == 'test-delivery@godelivery.com';
      }

      // Postularse sí; auto-aprobarse no.
      function statusChangesAreApplications() {
        return (!changed().hasAny(['deliveryStatus']) || request.resource.data.deliveryStatus == 'pending')
            && (!changed().hasAny(['commerceStatus']) || request.resource.data.commerceStatus == 'pending')
            && (!changed().hasAny(['tripStatus'])     || request.resource.data.tripStatus == 'pending');
      }

      // Lectura de un doc puntual: cualquiera con sesión (el cadete necesita
      // ver al cliente, el cliente al cadete). Listar/consultar la colección
      // entera: sólo personal. Esto es lo que impide bajarse la base de datos.
      allow get:  if isSignedIn();
      allow list: if isStaff();

      allow create: if isSelf() && (
        isAdmin() || isReviewTestAccount() || (
          request.resource.data.get('role', 'user') == 'user' &&
          request.resource.data.get('isAdmin', false) == false &&
          request.resource.data.get('isDelivery', false) == false &&
          request.resource.data.get('isComercio', false) == false
        )
      );

      allow update: if (isAdmin() && (ledgerFieldsUntouched() || ledgerMoveIsValid()))
        || (isSelf() && isReviewTestAccount() && ledgerFieldsUntouched())
        || (isSelf() && !changed().hasAny(protectedKeys()) && statusChangesAreApplications() && backfillIsValid())
        // Calificaciones y puntos cruzados (cliente ↔ cadete, referidos).
        || (isSignedIn() && !isSelf() && onlyFields(['ratings', 'points']));

      allow delete: if isAdmin();

      match /notifications/{notifId} {
        allow read, update, delete: if isAdmin() || (isSignedIn() && userId == uid());
        allow create: if isSignedIn();
      }

      match /fcmTokens/{token} {
        allow read: if isAdmin() || (isSignedIn() && userId == uid());
        allow write: if isSignedIn() && userId == uid();
      }

      match /challenges/{challengeId} {
        allow read, write: if isAdmin() || (isSignedIn() && userId == uid());
        // Quien entrega el pedido avanza los desafíos semanales del cliente: sólo de a un
        // paso y sólo los campos de progreso (antes fallaba y nunca se acreditaban).
        allow read: if isDriver();
        allow update: if isDriver()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'completed', 'completedAt', 'modalShown'])
          && request.resource.data.get('progress', 0) == resource.data.get('progress', 0) + 1;
      }
    }

    // Consulta de grupo usada por el panel de control para push masivos.
    match /{path=**}/fcmTokens/{token} {
      allow read: if isAdmin();
    }

    // -------------------------------------------------------------- comercios
    // Catálogo público: se navega sin login.

    // Vinculación con Ventra: los códigos los genera un admin. Las claves y el estado de cada
    // comercio vinculado solo los maneja el servidor (functions/ventra-bridge.js).
    match /ventra_links/{code} {
      allow read, create, delete: if isAdmin();
    }
    match /ventra_keys/{hash} {
      allow read, write: if false;
    }
    match /ventra_stores/{comercioId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Invitaciones a un comercio para un correo que todavía no entró a GO. Las crea y las
    // aplica el servidor (functions/commerce-access.js); el invitado solo ve las suyas.
    match /comercio_invites/{inviteId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email != null &&
        resource.data.email == request.auth.token.email.lower());
      allow write: if false;
    }

    match /comercios/{comercioId} {
      // Plata, dueño, aprobación, destaque pago y calificación: sólo el admin
      // (o el servidor). La comisión la lee la function al crear cada pedido.
      function adminOnlyKeys() {
        return [
          'ownerId', 'commissionRate', 'approvedByAdmin', 'isGoMarket',
          'promotion', 'isSponsored', 'sponsoredUntil',
          'ratingAverage', 'ratingCount',
          // "Compra el repartidor" y la vinculación con Ventra (ver functions/ventra-bridge.js)
          'fulfillmentMode', 'shopperMaxTotal', 'ventraLinked', 'ventraLinkedAt',
          // Correos con acceso de dueño (functions/commerce-access.js)
          'managerIds'
        ];
      }

      // Quien se postula (formulario "Sumá tu comercio") crea el comercio pendiente y apagado:
      // approvedByAdmin == false es lo que lo pone en la lista de solicitudes del admin.
      function isPendingApplication() {
        return request.resource.data.get('approvedByAdmin', false) == false &&
          request.resource.data.get('isActive', false) == false;
      }
      // Lo que sólo pone el admin, menos approvedByAdmin (va en false) y ownerId (es él mismo).
      function applicantForbiddenKeys() {
        return ['commissionRate', 'isGoMarket', 'promotion', 'isSponsored',
          'sponsoredUntil', 'ratingAverage', 'ratingCount',
          'fulfillmentMode', 'shopperMaxTotal', 'ventraLinked', 'ventraLinkedAt', 'managerIds'];
      }

      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.get('ownerId', '') == uid() &&
        !request.resource.data.keys().hasAny(applicantForbiddenKeys()) &&
        isPendingApplication() &&
        !('pin' in request.resource.data)
      );
      // El PIN vive en private/access; el doc público sólo puede perderlo.
      // Mientras el admin no lo aprueba, el dueño no puede ponerlo visible en el catálogo.
      allow update: if isAdmin() || (
        ownsComercio(comercioId) &&
        !changed().hasAny(adminOnlyKeys()) &&
        (!changed().hasAny(['pin']) || !('pin' in request.resource.data)) &&
        !(resource.data.get('approvedByAdmin', true) == false && request.resource.data.get('isActive', false) == true)
      );
      allow delete: if isAdmin();

      // PIN del panel y demás datos que no deben ser públicos.
      // "team" (quién tiene acceso) lo escribe solo el servidor.
      match /private/{docId} {
        allow read: if isAdmin() || ownsComercio(comercioId);
        allow write: if docId != 'team' && (isAdmin() || ownsComercio(comercioId));
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin() || ownsComercio(comercioId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin() || ownsComercio(comercioId);
      }
    }

    // Búsqueda global de productos (home, buscador, ofertas).
    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // ----------------------------------------------------------------- orders

    match /orders/{orderId} {
      function isCustomer()  { return isOwnerField('userId'); }
      function isAssigned()  { return isOwnerField('driverId'); }
      function isTheShop()   { return ownsComercio(resource.data.get('comercioId', '')); }

      // El cadete ve la bolsa de pedidos disponibles, no sólo los suyos.
      allow read: if isAdmin() || isDriver() || isCustomer() || isAssigned() || isTheShop();

      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == uid() || isStaff()
      );

      // La comisión la fija el servidor al crear el pedido y la cobra el admin.
      function shopLockedKeys() {
        return ['commissionAmount', 'commissionRate', 'commissionStatus', 'commissionPaidAt', 'comercioId', 'userId'];
      }

      allow update: if isAdmin() || isDriver() || isCustomer() ||
        (isTheShop() && !changed().hasAny(shopLockedKeys()));

      // Borrar un pedido borra también su comisión: sólo el admin.
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin() || isDriver() || isCustomer() || isTheShop();
        allow update, delete: if isAdmin();
      }

      // Ubicación en vivo del cadete (cada pocos segundos). Vive fuera del doc del
      // pedido para no disparar onOrderStatusChange en cada punto de GPS. La lee
      // quien puede leer el pedido; la escribe sólo el cadete asignado.
      // fixAt: hora de la lectura del GPS (ms); accuracy: precisión en metros. Con fixAt el
      // mapa del cliente mueve la moto al ritmo real y no al que llegan los datos.
      match /live/{liveId} {
        function parentOrder() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        allow read: if isAdmin() || isDriver() || (isSignedIn() && (
          parentOrder().get('userId', '') == uid() ||
          parentOrder().get('driverId', '') == uid() ||
          ownsComercio(parentOrder().get('comercioId', ''))
        ));
        allow write: if isSignedIn() && liveId == 'driver' &&
          parentOrder().get('driverId', '') == uid() &&
          request.resource.data.keys().hasOnly(['lat', 'lng', 'heading', 'speed', 'updatedAt', 'fixAt', 'accuracy']) &&
          request.resource.data.lat is number && request.resource.data.lng is number &&
          request.resource.data.get('fixAt', 0) is number &&
          request.resource.data.get('accuracy', 0) is number;
      }
    }

    match /favor_orders/{favorId} {
      allow read:   if isAdmin() || isDriver() || isOwnerField('userId');
      allow create: if isSignedIn();
      allow update: if isAdmin() || isDriver() || isOwnerField('userId');
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------ chats

    // El array `participants` mezcla uids con comercioId, y los pedidos no
    // guardan comercioOwnerId, así que la pertenencia también se valida contra
    // el pedido vinculado: cliente, cadete asignado y dueño del comercio.
    function isPartyOfOrder(orderId) {
      return isSignedIn() && orderId is string && orderId != '' &&
        exists(/databases/$(database)/documents/orders/$(orderId)) && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.get('userId', '') == uid() ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.get('driverId', '') == uid() ||
          ownsComercio(get(/databases/$(database)/documents/orders/$(orderId)).data.get('comercioId', ''))
        );
    }

    function chatOf(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // El id del chat es `${orderId}_${tipo}`. La app empieza a escuchar los mensajes antes de
    // que exista el doc del chat (lo crea en segundo plano); sin esto la primera escucha era
    // rechazada y quedaba muerta: el que abría el chat no veía ni lo que mandaba.
    function orderOfChatId(chatId) {
      return chatId.split('_')[0];
    }

    function canUseChat(chatId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/chats/$(chatId))
          ? (uid() in chatOf(chatId).get('participants', []) ||
             isPartyOfOrder(chatOf(chatId).get('orderId', '')))
          : isPartyOfOrder(orderOfChatId(chatId))
      );
    }

    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && (
          uid() in resource.data.get('participants', []) ||
          isPartyOfOrder(resource.data.get('orderId', ''))
        );
      }

      // Un chat que todavía no existe no tiene nada que mostrar: se puede consultar.
      allow get:    if isAdmin() || resource == null || isParticipant();
      allow list:   if isAdmin() || isParticipant();
      allow create: if isSignedIn() && (
        uid() in request.resource.data.get('participants', []) ||
        isPartyOfOrder(request.resource.data.get('orderId', ''))
      );
      allow update: if isAdmin() || isParticipant();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read:   if canUseChat(chatId);
        // El primer mensaje puede llegar antes de que exista el doc del chat.
        allow create: if canUseChat(chatId) ||
          (isSignedIn() && !exists(/databases/$(database)/documents/chats/$(chatId)));
        allow update: if canUseChat(chatId);
        allow delete: if isAdmin();
      }
    }

    match /support_chats/{ticketId} {
      function isMine() {
        return isSignedIn() && (
          ticketId == uid() || resource.data.get('userId', '') == uid()
        );
      }

      // Los tickets se abren con el id del pedido, del comercio o `driver_<uid>`, y la app mira
      // si ya existen antes del primer mensaje. Un ticket inexistente no tiene nada que leer.
      allow get:    if isAdmin() || resource == null || isMine();
      allow list:   if isAdmin() || isMine();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isMine();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if isAdmin() || ticketId == uid() ||
          (exists(/databases/$(database)/documents/support_chats/$(ticketId)) &&
           get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('userId', '') == uid());
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------ bot de WhatsApp
    // Pedidos escritos por WhatsApp que el comercio cotiza (functions/whatsapp/). Los crea el
    // servidor; el comercio responde una sola vez: precio o "no lo tengo". Teléfono y dirección
    // del cliente los ve solo ese comercio.
    match /wa_quotes/{quoteId} {
      function isTheShop() { return ownsComercio(resource.data.get('comercioId', '')); }

      allow read: if isAdmin() || isTheShop();
      allow update: if (isAdmin() || isTheShop()) &&
        resource.data.status == 'waiting' &&
        onlyFields(['status', 'price', 'prepMinutes', 'commerceNote', 'rejectReason', 'answeredAt', 'answeredBy']) &&
        (
          (request.resource.data.status == 'quoted' &&
            request.resource.data.price is number &&
            request.resource.data.price > 0 && request.resource.data.price <= 5000000 &&
            request.resource.data.get('prepMinutes', 20) is number) ||
          request.resource.data.status == 'rejected'
        );
    }

    // Estado de cada charla, mensajes ya atendidos y mensajes de prueba: solo el servidor.
    // El admin puede tomar una charla (pasa a soporte) o devolverla al bot, nada más.
    match /wa_sessions/{waId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['step', 'data', 'humanTakeoverAt']);
    }
    match /wa_inbound/{messageId} { allow read: if isAdmin(); }
    match /wa_outbox/{messageId} { allow read: if isAdmin(); }
    // Modo prueba del bot: lista de números (personales) a los que contesta. No va en settings,
    // que lee cualquiera.
    match /wa_config/{docId} { allow read, write: if isAdmin(); }
    // Uso de la IA del bot (tokens por llamada) y clientes esperando cadete: solo el servidor escribe
    match /wa_ai_log/{id} { allow read: if isAdmin(); }
    match /wa_waitlist/{waId} { allow read: if isAdmin(); }
    // Mensajes del bot por mes (cupo gratis de Meta): solo el servidor escribe
    match /wa_usage/{month} { allow read: if isAdmin(); }

    // ------------------------------------------------------------ marketplace

    match /marketplace_products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.get('sellerId', '') == uid();
      allow update: if isAdmin() || isOwnerField('sellerId');
      allow delete: if isAdmin() || isOwnerField('sellerId');
    }

    match /marketplace_chats/{chatId} {
      function isParty() {
        return isSignedIn() && (
          resource.data.get('buyerId', '') == uid() ||
          resource.data.get('sellerId', '') == uid()
        );
      }

      allow read:   if isAdmin() || isParty();
      allow create: if isSignedIn() && (
        request.resource.data.get('buyerId', '') == uid() ||
        request.resource.data.get('sellerId', '') == uid()
      );
      allow update: if isAdmin() || isParty();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if isAdmin() || (
          exists(/databases/$(database)/documents/marketplace_chats/$(chatId)) && (
            get(/databases/$(database)/documents/marketplace_chats/$(chatId)).data.get('buyerId', '') == uid() ||
            get(/databases/$(database)/documents/marketplace_chats/$(chatId)).data.get('sellerId', '') == uid()
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------- catálogo público / marketing

    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /platformCategories/{categoryId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read:  if true;
      allow write: if isAdmin() || isComercioUser();
    }

    // Dónde queda cada comercio de los mandados (el cliente lo escribe a mano). Lo aprende la app
    // con la ubicación del repartidor al terminar de comprar; el admin lo revisa y lo corrige.
    match /mandadoPlaces/{placeId} {
      function validPlace() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'slug', 'category', 'lat', 'lng', 'samples', 'visits', 'verified',
                                 'support', 'conflict',
                                 'lastDriverUid', 'updatedAt', 'createdAt', 'address', 'hidden', 'reviewedAt']) &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
          d.slug == placeId &&
          d.lat is number && d.lat > -35.6 && d.lat < -34.6 &&
          d.lng is number && d.lng > -58.1 && d.lng < -57.0 &&
          (!('samples' in d) || (d.samples is list && d.samples.size() <= 8));
      }
      // El repartidor solo suma visitas: no puede verificar, ocultar ni firmar por otro
      function driverWrite() {
        let d = request.resource.data;
        return isDriver() && validPlace() &&
          d.get('lastDriverUid', '') == uid() &&
          (resource == null || d.name == resource.data.name) &&
          (resource == null || !resource.data.get('verified', false) ||
            (d.lat == resource.data.lat && d.lng == resource.data.lng)) &&
          d.get('verified', false) == (resource == null ? false : resource.data.get('verified', false)) &&
          d.get('hidden', false) == (resource == null ? false : resource.data.get('hidden', false));
      }
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() && validPlace()) || driverWrite();
      allow delete: if isAdmin();
    }

    match /banners_mandados/{bannerId} {
      allow read:   if true;
      allow create: if isAdmin() || isComercioUser();
      // Contador de clics/vistas desde la app.
      allow update: if isAdmin() || isComercioUser() || (isSignedIn() && onlyFields(['stats']));
      allow delete: if isAdmin();
    }

    match /customAds/{adId} {
      allow read:   if true;
      allow create: if isAdmin() || isComercioUser();
      allow update: if isAdmin() || isComercioUser() || (isSignedIn() && onlyFields(['stats']));
      allow delete: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /automated_broadcasts/{broadcastId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == uid();
      allow update: if isAdmin() || isOwnerField('userId');
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- cupones

    match /coupons/{couponId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() || isComercioUser();
      allow update: if isAdmin() || isComercioUser() || (isSignedIn() && onlyFields(['usedCount', 'remaining']));
      allow delete: if isAdmin() || isComercioUser();

      match /redemptions/{userId} {
        allow read:   if isAdmin() || (isSignedIn() && userId == uid());
        allow create: if isSignedIn() && userId == uid();
        allow update, delete: if isAdmin();
      }
    }

    // ------------------------------------------------ cadetes: sesiones y plata

    match /deliverySessions/{sessionId} {
      allow read:   if isAdmin() || isOwnerField('driverId');
      allow create: if isAdmin() || (isDriver() && request.resource.data.get('driverId', '') == uid());
      allow update: if isAdmin() || isOwnerField('driverId');
      allow delete: if isAdmin();
    }

    // Cuenta corriente del cadete: un renglón por cada peso que mueve su saldo.
    // Pedidos y cuota diaria los escribe el servidor; cobros, pagos al cadete, ajustes y
    // anulaciones, el admin. Nunca se borran: anular es agregar el renglón inverso.
    // Ver src/utils/driver-ledger.js.
    match /driver_ledger/{entryId} {
      function near(a, b) {
        return math.abs(a - b) < 0.01;
      }
      function driverBefore() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.driverId)).data;
      }
      function driverAfter() {
        return getAfter(/databases/$(database)/documents/users/$(request.resource.data.driverId)).data;
      }
      function signIsValid(d) {
        return (d.type == 'payment' && d.amount < 0) ||
               (d.type == 'payout' && d.amount > 0) ||
               (d.type in ['adjustment', 'reversal'] && d.amount != 0);
      }
      // Saldo inicial: lo que decía deliveryDebt antes del primer renglón.
      function isOpening(d) {
        return d.type == 'opening' && entryId == 'open_' + d.driverId &&
          driverBefore().get('ledgerOpened', false) != true &&
          near(d.amount, driverBefore().get('deliveryDebt', 0)) && d.balanceAfter == d.amount;
      }
      // Movimiento del admin: saldo anterior + monto, y es el renglón que queda como último.
      function isAdminMove(d) {
        return signIsValid(d) &&
          driverAfter().get('ledgerLastEntryId', '') == entryId &&
          near(d.balanceAfter, driverBefore().get('deliveryDebt', 0) + d.amount);
      }

      allow read: if isAdmin() || isOwnerField('driverId');
      allow create: if isAdmin() &&
        request.resource.data.driverId is string &&
        request.resource.data.amount is number &&
        request.resource.data.balanceAfter is number &&
        (isOpening(request.resource.data) || isAdminMove(request.resource.data));
      // Lo único que cambia de un renglón es la marca de anulado, una sola vez.
      allow update: if isAdmin() &&
        onlyFields(['reversedById', 'reversedAt', 'reversedBy']) &&
        resource.data.get('reversedById', null) == null &&
        existsAfter(/databases/$(database)/documents/driver_ledger/$(request.resource.data.reversedById));
      allow delete: if false;
    }

    // Trabajos que corre el servidor a pedido del admin (p. ej. importar la historia anterior
    // de las cuentas): el admin crea el pedido y lee cómo va; el resultado lo escribe el servidor.
    match /system_jobs/{jobId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Movimientos y cuotas del sistema anterior: los siguen escribiendo el servidor y el
    // admin junto con cada renglón, porque las pantallas y reportes actuales los leen.
    // El cadete sólo los lee.
    match /delivery_transactions/{transactionId} {
      allow read:  if isAdmin() || isOwnerField('driverId');
      allow write: if isAdmin();
    }

    match /delivery_canon_payments/{paymentId} {
      allow read:  if isAdmin() || isOwnerField('driverId');
      allow write: if isAdmin();
    }

    // Liquidaciones de deuda que registra el admin (historial de cobros).
    match /delivery_debt_settlements/{settlementId} {
      allow read:  if isAdmin() || isOwnerField('driverId');
      allow write: if isAdmin();
    }

    match /delivery_settlement_proofs/{proofId} {
      allow read:   if isAdmin() || isOwnerField('driverId');
      allow create: if isAdmin() || isDriver();
      allow update, delete: if isAdmin();
    }

    match /delivery_applications/{applicationId} {
      allow read:   if isAdmin() || applicationId == uid() || isOwnerField('userId');
      allow create: if isSignedIn() && applicationId == uid();
      allow update: if isAdmin() || applicationId == uid();
      allow delete: if isAdmin();
    }

    match /trip_applications/{applicationId} {
      allow read:   if isAdmin() || applicationId == uid() || isOwnerField('userId');
      allow create: if isSignedIn() && applicationId == uid();
      allow update: if isAdmin() || applicationId == uid();
      allow delete: if isAdmin();
    }

    match /job_applications/{applicationId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------- caja de la empresa
    // Liquidaciones, comisiones y gastos: sólo administración.

    match /settlements/{settlementId} {
      allow read, write: if isAdmin();
    }

    match /owner_settlements/{settlementId} {
      allow read, write: if isAdmin();
    }

    match /company_expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /whatsapp_commerces/{commerceId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------------------------- notificaciones y puntos

    // Diagnóstico de reinicios de la app (utils/reload-log.js). Cada uno anota el suyo.
    // Detector de errores: los escribe sólo el servidor (functions/client-errors.js).
    // El admin los mira y les cambia el estado (resuelto / ignorado / abierto).
    // Estado del vigilante (última pasada, revisiones): lo escribe el servidor, el admin lo mira.
    match /system/vigilante {
      allow read: if isAdmin();
    }

    match /client_errors/{fingerprint} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBy', 'statusAt', 'note']);
    }

    match /app_restarts/{restartId} {
      allow create: if isSignedIn() && request.resource.data.get('uid', '') == uid();
      allow read, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read:   if isAdmin() || isOwnerField('userId');
      allow create: if isSignedIn();
      allow update: if isAdmin() || isOwnerField('userId');
      allow delete: if isAdmin();
    }

    match /points_transactions/{transactionId} {
      allow read:   if isAdmin() || isOwnerField('userId');
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------ telemetría interna

    match /visits/{visitId} {
      allow read:  if isAdmin();
      allow write: if isSignedIn() && request.resource.data.get('userId', '') == uid();
    }

    // Contador para el número de cliente correlativo (se toca al registrarse).
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // --------------------------------------------------------- sorteos
    // Las entries (y sus chances) las escribe solo el servidor (joinGiveaway,
    // pedidos entregados, referidos). Si el cliente pudiera crear la suya,
    // podría anotarse con las chances que quisiera.
    match /giveaways/{giveawayId} {
      allow read:  if true;
      allow write: if isAdmin();

      match /entries/{entryId} {
        allow read:  if true;
        allow write: if isAdmin();
      }
    }
  }
}
