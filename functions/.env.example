# Copiar como functions/.env (no se sube a git) y completar. Ver functions/whatsapp/README.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Id de la app de Meta: lo usa "Vincular con Meta" de Admin → Bot WhatsApp → Ajustes
WHATSAPP_APP_ID=
# id del formulario nativo (node scripts/wa-flow.mjs create <WABA_ID>); sin él, el bot pregunta por el chat
WHATSAPP_FLOW_ID=
# "draft" mientras Meta no deje publicarlo (pide el negocio verificado)
WHATSAPP_FLOW_MODE=
# IA del bot (Claude Haiku 5.5), solo para pedidos que las reglas no entienden. Ver functions/whatsapp/README.md
ANTHROPIC_API_KEY=
