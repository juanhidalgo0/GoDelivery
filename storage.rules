rules_version = '2';

// ============================================================================
// GoDelivery Magdalena — Reglas de Cloud Storage
//
// Las imágenes del catálogo (logos, banners, productos, avatares) son públicas
// porque se muestran sin login. Los documentos personales de cadetes —CV,
// licencia de conducir, seguro— y los comprobantes de liquidación NO lo son.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kioscopaulos7@gmail.com' || (
          // Igual que isAdmin() de firestore.rules: rol admin o la marca isAdmin (admins que
          // también reparten tienen rol "delivery" y no podían guardar el video del sorteo)
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'superadmin'] ||
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          )
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ------------------------------------------------ catálogo e imágenes públicas

    match /comercios/{allPaths=**} {
      allow read:  if true;
      allow write: if isSignedIn() && isImage() && underSize(10);
    }

    match /products/{allPaths=**} {
      allow read:  if true;
      allow write: if isSignedIn() && isImage() && underSize(10);
    }

    match /ads/{allPaths=**} {
      allow read:  if true;
      allow write: if isSignedIn() && isImage() && underSize(10);
    }

    match /marketplace/{allPaths=**} {
      allow read:  if true;
      allow write: if isSignedIn() && isImage() && underSize(10);
    }

    match /broadcasts/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin() && underSize(10);
    }

    // Video del sorteo para stories (lo genera el admin en Admin → Sorteos)
    match /giveaways/{giveawayId}/{fileName} {
      allow read:  if true;
      allow write: if isAdmin() && request.resource.contentType.matches('video/.*') && underSize(60);
    }

    // Foto de perfil: pública, pero cada uno escribe la suya.
    match /avatars/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if isOwner(userId) && isImage() && underSize(10);
    }

    // ------------------------------------------------------------------- chats
    // Fotos y audios de conversaciones: sólo con sesión iniciada.

    match /chats/{allPaths=**} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && underSize(25);
    }

    // -------------------------------------------- documentación personal (privada)
    // Licencia, seguro, CV y comprobantes. Los ve su dueño y la administración.

    match /delivery_applications/{userId}/{allPaths=**} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && underSize(15);
    }

    match /trip_applications/{userId}/{allPaths=**} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && underSize(15);
    }

    // Los comprobantes se suben como `delivery_receipts/{uid}_{timestamp}.ext`,
    // así que la pertenencia se valida por prefijo del nombre.
    match /delivery_receipts/{fileName} {
      allow read:  if (isSignedIn() && fileName.split('_')[0] == request.auth.uid) || isAdmin();
      allow write: if isSignedIn() && fileName.split('_')[0] == request.auth.uid && underSize(15);
    }

    // Foto del ticket de "compra el repartidor": la sube el repartidor del pedido; la ven él,
    // el cliente y la administración.
    match /order_tickets/{orderId}/{fileName} {
      allow read:  if isAdmin() || (isSignedIn() && request.auth.uid in [
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.get('driverId', ''),
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.get('userId', '')
      ]);
      allow write: if isSignedIn() && isImage() && underSize(10)
        && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.get('driverId', '') == request.auth.uid;
    }

    // Cualquier otra ruta queda cerrada por defecto.
  }
}
