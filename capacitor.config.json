{
  "appId": "com.godelivery.magdalena",
  "appName": "GO!",
  "webDir": "dist",
  "server": {
    "url": "https://godelivery-magdalena.web.app",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "launchFadeDuration": 150,
      "backgroundColor": "#E11D48",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "androidSplashResourceName": "splash"
    },
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
